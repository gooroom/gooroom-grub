From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jongkyung.woo <jkwoo@gooroom.kr>
Date: Mon, 09 Feb 2026 14:20:00 +0900
Subject: [PATCH] Change GRUB title from 'GNU GRUB' to 'Gooroom GRUB' and add
 GRM_GRUB_VERSION

This merges the old gooroom-0002 and gooroom-0005 patches.
Instead of creating a separate config.h, we define GRM_GRUB_VERSION
directly in main.c and use it in the title display.
---
 grub-core/normal/main.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/grub-core/normal/main.c b/grub-core/normal/main.c
index 1a8b22a..2c7e8b3 100644
--- a/grub-core/normal/main.c
+++ b/grub-core/normal/main.c
@@ -39,6 +39,9 @@ GRUB_MOD_LICENSE ("GPLv3+");

 #define GRUB_DEFAULT_HISTORY_SIZE	50

+/* Version number of gooroom GRUB  */
+#define GRM_GRUB_VERSION "5.0"
+
 static int nested_level = 0;
 int grub_normal_exit_level = 0;

@@ -209,7 +212,7 @@ grub_normal_init_page (struct grub_term_output *term,

   grub_term_cls (term);

-  msg_formatted = grub_xasprintf (_("GNU GRUB  version %s"), PACKAGE_VERSION);
+  msg_formatted = grub_xasprintf (_("Gooroom GRUB  version %s"), GRM_GRUB_VERSION);
   if (!msg_formatted)
     return;

--
2.30.2
